# Auto YOLO Training 环境变量示例
#
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env       (Linux/macOS/Git Bash)
#   Copy-Item .env.example .env (PowerShell)
#
# 本文件列出所有受支持的环境变量。修改后无需重启——Python/Ultralytics/Gradio
# 在 import 时读取，多数变量可在运行时通过 CLI 参数覆盖。

# ============================================================================
# 品牌与展示（阶段 A3 引入）
# ============================================================================

# 项目显示名（默认 "Auto YOLO Training"）
# 用于 CLI banner、FastAPI 服务名、Gradio 标题
# YOLO_BRAND_NAME=Auto YOLO Training

# 项目副标题（默认 "通用 YOLO 模型自动训练平台 · ..."）
# YOLO_BRAND_TAGLINE=通用 YOLO 模型自动训练平台

# 项目描述（默认 "通用 YOLO 模型自动训练平台"）
# YOLO_BRAND_DESCRIPTION=通用 YOLO 模型自动训练平台

# FastAPI 服务标题（默认 "YOLO Inference API"）
# 内部部署时建议改为企业/部门名称，例如：
# YOLO_API_TITLE=MyFactory Detection API

# FastAPI 服务描述（默认 "基于 Ultralytics 的 YOLO 模型推理服务"）
# YOLO_API_DESCRIPTION=基于 Ultralytics 的 YOLO 模型推理服务

# 版权字符串（默认 "Auto YOLO Training Contributors"）
# YOLO_BRAND_COPYRIGHT=MyCompany © 2026

# ============================================================================
# 路径与配置
# ============================================================================

# 项目根目录覆盖（默认 = 脚本所在目录）
# YOLO_PROJECT_ROOT=/path/to/project

# Ultralytics 配置目录（避免写入用户主目录；默认 .ci/ultralytics/）
# YOLO_CONFIG_DIR=.ci/ultralytics

# Matplotlib 配置目录（避免首次运行崩溃；默认 .ci/matplotlib/）
# MPLCONFIGDIR=.ci/matplotlib

# Matplotlib 后端（默认 Agg，无 GUI 环境）
# MPLBACKEND=Agg

# Windows 系统根目录（沙箱环境补救）
# WINDIR=C:\Windows

# ============================================================================
# 训练运行时
# ============================================================================

# Polars CPU 检查跳过（仅在受限沙箱中临时使用）
# ⚠️ 生产部署应先确认 CPU 与 wheel 兼容，不应盲目跳过
# POLARS_SKIP_CPU_CHECK=1

# Gradio 遥测/分析禁用（默认 False，避免无网络环境报错）
# GRADIO_ANALYTICS_ENABLED=False

# Python IO 编码（Windows 中文输出必备；阶段 A6 后建议显式设置）
PYTHONIOENCODING=utf-8

# Python UTF-8 模式（推荐在 CI/容器中启用）
PYTHONUTF8=1

# 不写 pyc（CI 默认开启）
PYTHONDONTWRITEBYTECODE=1

# ============================================================================
# FastAPI 推理服务（serve.py）
# ============================================================================

# API Key 认证（建议生产部署必填；空字符串 = 不启用认证）
# 用于请求头 X-API-Key 校验
# YOLO_API_KEY=replace-with-a-strong-secret

# ============================================================================
# Notifier Webhook 通知
# ============================================================================

# Webhook 允许的域名白名单（逗号分隔；覆盖默认 [oapi.dingtalk.com, ...]）
# 用于 SSRF 防护；留空 = 使用默认白名单
# YOLO_WEBHOOK_ALLOWED_DOMAINS=oapi.dingtalk.com,open.feishu.cn,qyapi.weixin.qq.com