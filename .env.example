# Auto YOLO Training 环境变量示例
#
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env       (Linux/macOS/Git Bash)
#   Copy-Item .env.example .env (PowerShell)
#
# 本文件列出所有受支持的环境变量。修改后无需重启——Python/Ultralytics/Gradio
# 在 import 时读取，多数变量可在运行时通过 CLI 参数覆盖。

# ============================================================================
# 品牌与展示（阶段 A3 引入 / 阶段 B5 用 Pydantic Settings 接管）
# ============================================================================

# 嵌套字段用双下划线 __ 分隔（单下划线会被 Pydantic 当作 delimiter）。
# 所有变量必须有 YOLO_ 前缀。

# YOLO_BRAND__NAME=Auto YOLO Training
# YOLO_BRAND__TAGLINE=通用 YOLO 模型自动训练平台
# YOLO_BRAND__DESCRIPTION=通用 YOLO 模型自动训练平台
# YOLO_BRAND__API_TITLE=MyFactory Detection API
# YOLO_BRAND__API_DESCRIPTION=基于 Ultralytics 的 YOLO 模型推理服务
# YOLO_BRAND__COPYRIGHT=MyCompany © 2026

# ============================================================================
# 运行时（阶段 B5）
# ============================================================================

# YOLO_RUNTIME__DEVICE=auto       # '' / 'cpu' / '0' / '0,1'（空=Ultralytics 自动）
# YOLO_RUNTIME__WORKERS=8
# YOLO_RUNTIME__SKIP_VALIDATION_DEFAULT=false
# YOLO_RUNTIME__SKIP_POLARS_CPU_CHECK=false

# ============================================================================
# FastAPI 服务
# ============================================================================

# YOLO_API__API_KEY=replace-with-a-strong-secret
# YOLO_API__REQUIRE_AUTH=false          # 当 api_key 非空时自动启用
# YOLO_API__ALLOWED_IMAGE_DIRS=["dataset","test_images"]
# YOLO_API__ALLOWED_MODEL_DIRS=["runs","basemodels"]

# ============================================================================
# 存储路径
# ============================================================================

# YOLO_STORAGE__ULTRALYTICS_CONFIG_DIR=.ci/ultralytics
# YOLO_STORAGE__MATPLOTLIB_CONFIG_DIR=.ci/matplotlib
# YOLO_STORAGE__MATPLOTLIB_BACKEND=Agg

# ============================================================================
# 通知（notifier）
# ============================================================================

# YOLO_NOTIFIER__WEBHOOK_ALLOWED_DOMAINS=oapi.dingtalk.com,open.feishu.cn,qyapi.weixin.qq.com,hooks.slack.com

# ============================================================================
# 旧版平铺变量（阶段 B5 之前的环境变量，src/__init__.py 兼容读取）
# ============================================================================

# YOLO_API_KEY（== YOLO_API__API_KEY）
# YOLO_PROJECT_ROOT
# YOLO_CONFIG_DIR（== YOLO_STORAGE__ULTRALYTICS_CONFIG_DIR）
# YOLO_WEBHOOK_ALLOWED_DOMAINS（== YOLO_NOTIFIER__WEBHOOK_ALLOWED_DOMAINS）